      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(health_checks_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
