# Stage 1: Build

FROM golang:1.25.0 AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN go build -o payment-service ./cmd/payment-service


# Stage 2:

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /app/payment-service .

EXPOSE 8081

CMD ["./payment-service"]
